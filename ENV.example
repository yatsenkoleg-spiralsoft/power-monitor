# Пример файла переменных окружения
# Скопируйте этот файл в .env и заполните реальными значениями
# НЕ КОММИТЬТЕ .env в Git!

# Tuya API credentials (обязательно)
TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_KEY=your_tuya_access_key

# MySQL connection (обязательно)
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Tuya API URL (опционально)
TUYA_API_URL=https://openapi.tuyaeu.com

# EcoFlow — уровень заряда экофлошки (опционально)
# Нужны: ECOFLOW_ACCESS_KEY, ECOFLOW_SECRET_KEY и ECOFLOW_DEVICE_SN
# Получите AccessKey и SecretKey в Developer Portal: https://developer.ecoflow.com/
# ECOFLOW_ACCESS_KEY=your_access_key
# ECOFLOW_SECRET_KEY=your_secret_key
# ECOFLOW_DEVICE_SN=your_device_serial_number
# ECOFLOW_HOST=https://api.ecoflow.com

# Device IDs (опционально, если не указано - используются значения по умолчанию)
# DEVICE_IDS={"Розетка 1":"bf3c70a960958bcf11ruml","Розетка 2":"bfcbd371e1af7827f9sj79","T & H Sensor":"bf2bf2252c37a041b0tbvs","Свет на кухне":"bf2a33ded6cd1955cbumtz","Бойлер":"bf935c8cff3752fbecgfew","Подсветка цветам":"bffd4e253c18de762ct932"}

# Server port (опционально)
PORT=8080
